{
  "name": "rust-bun-api",
  "private": true,
  "scripts": {
    "build": "bun run --workspaces build",
    "dev": "bun run ./scripts/dev-core-api.ts",
    "start": "bun run --workspaces start",
    "test": "bun run --workspaces test",
    "check": "ultracite check .",
    "fix": "ultracite fix && bun run --workspaces format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "ultracite": "^7.2.2"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.9"
    }
  }
}
