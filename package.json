{
  "name": "rust-bun-api",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "check": "ultracite check .",
    "lint:write": "ultracite lint . --write",
    "format:write": "ultracite format . --write && turbo run format",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "turbo": "^2.8.4",
    "typescript": "^5.9.3",
    "ultracite": "^7.1.5"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
