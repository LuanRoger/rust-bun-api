{
  "name": "rust-bun-api",
  "private": true,
  "scripts": {
    "build": "bun run --filter=\"*\" build",
    "dev": "bun run --filter=\"*\" dev",
    "start": "bun run --filter=\"*\" start",
    "test": "bun run --filter=\"*\" test",
    "check": "ultracite check .",
    "fix": "ultracite fix && bun run --filter=\"*\" format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "ultracite": "^7.2.2"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.9"
    }
  }
}
