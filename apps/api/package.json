{
  "name": "api",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-whitespace --minify-syntax --external @repo/core",
    "compile": "bun build ./src/index.ts --compile --minify-whitespace --minify-syntax --target bun --outfile ./dist/compiled/api --external @repo/core",
    "start": "NODE_ENV=production bun run ./dist/index.js"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "elysia": "^1.4.24",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.9"
  }
}
